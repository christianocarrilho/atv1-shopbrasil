# Configuração opcional do Compose. Copie para .env apenas para personalizar o ambiente.
# Campos vazios usam os valores de demonstração definidos no docker-compose.yml.
# Use senhas alfanuméricas: elas entram em URLs e no JSON da Connection sem escape.

# Catálogo. Use uma URL controlada para os testes E2E.
FAKESTORE_BASE_URL=https://fakestoreapi.com

# Conta administrativa do PostgreSQL. Aplica o esquema e os GRANTs no db-init.
# A senha vale na criação do volume; para trocá-la depois, use ALTER ROLE.
POSTGRES_USER=shopbrasil_admin
POSTGRES_PASSWORD=

# PostgreSQL analítico. Host e porta são vistos pelo serviço que abre a conexão.
SHOPBRASIL_DB_HOST=postgres
SHOPBRASIL_DB_PORT=5432
SHOPBRASIL_DB_NAME=shopbrasil

# O pipeline publica com esta conta, pela Connection shopbrasil_postgres do Airflow.
SHOPBRASIL_DB_WRITER_USER=shopbrasil_writer
SHOPBRASIL_DB_WRITER_PASSWORD=

# A Web/API consulta com uma conta separada de leitura.
SHOPBRASIL_DB_READER_USER=shopbrasil_reader
SHOPBRASIL_DB_READER_PASSWORD=
# Porta da Web/API em http://localhost:${SHOPBRASIL_WEB_PORT}, publicada só em 127.0.0.1.
SHOPBRASIL_WEB_PORT=8098

# Banco de metadados do Airflow, no mesmo servidor PostgreSQL.
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=

# Segredo compartilhado pelos processos do Airflow 3 (por exemplo, `openssl rand -hex 32`).
AIRFLOW_JWT_SECRET=
# Opcional. Cifra Connections e Variables gravadas no banco de metadados.
AIRFLOW_FERNET_KEY=

# Usuário da interface do Airflow em http://localhost:${AIRFLOW_API_PORT}.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_API_PORT=8099

# UID dono dos arquivos criados pelo Airflow. No Linux, use o resultado de `id -u`.
AIRFLOW_UID=50000
