# Navegador real para os cenários E2E do painel (#23): Chromium do Playwright 1.49.0, versão fixada.
# A imagem oficial traz os navegadores; o pacote Python vai na mesma versão.
FROM mcr.microsoft.com/playwright/python:v1.49.0-noble
RUN pip install --no-cache-dir --break-system-packages playwright==1.49.0
