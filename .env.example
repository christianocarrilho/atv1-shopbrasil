# Configuração inicial de desenvolvimento. O Docker e os módulos integrarão estas variáveis nas issues de implementação.

# Catálogo. Use uma URL controlada para os testes E2E.
FAKESTORE_BASE_URL=https://fakestoreapi.com

# PostgreSQL analítico. Host e porta são vistos pelo serviço que abre a conexão.
SHOPBRASIL_DB_HOST=postgres
SHOPBRASIL_DB_PORT=5432
SHOPBRASIL_DB_NAME=shopbrasil

# O pipeline publica com esta conta. Preencha as senhas no .env local.
SHOPBRASIL_DB_WRITER_USER=shopbrasil_writer
SHOPBRASIL_DB_WRITER_PASSWORD=

# A Web/API consulta com uma conta separada de leitura.
SHOPBRASIL_DB_READER_USER=shopbrasil_reader
SHOPBRASIL_DB_READER_PASSWORD=
